{
  "name": "excalibrain",
  "version": "0.2.18",
  "private": true,
  "description": "jev assisted 3d excalibrain: a fork of ExcaliBrain, the editable graph view for Obsidian.",
  "main": "main.js",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "validate": "node scripts/validate-release.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "package": "npm run build && node scripts/package-plugin.mjs && node scripts/validate-release.mjs --artifacts",
    "check": "npm run validate && npm run lint && npm test && npm run package",
    "harness:prepare": "npm run check && node scripts/prepare-test-vault.mjs",
    "harness:preflight": "node scripts/preflight.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "repo:export": "node scripts/generate-repository-zip.mjs",
    "repo:update": "node scripts/update-repository.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "@types/node": "22.20.3",
    "@vitest/coverage-v8": "5.0.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.12.0",
    "obsidian": "1.8.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1",
    "yaml": "2.9.1"
  },
  "overrides": {
    "moment": "2.31.0"
  }
}
